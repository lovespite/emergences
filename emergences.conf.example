# Emergences 配置示例（UTF-8）
# 本文件随可执行文件分发。将它复制为程序旁的 emergences.conf 即可使用，
# 或通过 emergences.exe --config <配置文件路径> 指定一份可写的配置。
# 程序自动读取 emergences.conf，不会自动读取本示例；构建时会更新本示例。
# 面板、快捷键和相机修改会自动保存到正在使用的配置，正常退出时也会保存。
# 手动编辑配置前请先关闭程序，编辑完成后重新启动；运行时不监视文件修改。
# 保存的是设置；每次启动重新生成个体，个体位置、速度轨迹和模拟时间不存档。
#
# 格式：key = value。# 和 ; 后的文字为注释；布尔值 on 为开启，off 为关闭。
# 枚举名称区分大小写；数值须有限且在标注范围内，范围端点均包含。
# 缺少某项时使用代码默认值；下文分别列出默认值与可修改的示例值。
# 本示例的 min_speed=8、max_speed=14、fullscreen=on 有意不同于默认值。
# 距离使用模拟世界单位，时间使用模拟秒；Boids 世界三轴范围均为 [-40, 40]。
# 蚁群在 y=0 的 XZ 平面上活动，X、Z 范围同为 [-80, 80]。

# ── 启动场景 ────────────────────────────────────────────────────────

# 正常启动时选中的场景。可选 boids（默认）、ants（蚁群）或 particle_life（粒子生命）。
# 运行中可以在控制面板切换；每个场景的参数独立保存，显示选项和相机共用。
# --render-preview 仍进入程序化预览，不受此选项影响。
app.scenario = boids

# ── Boids 场景：数量与运行状态 ──────────────────────────────────────

# 个体数量。整数范围 0..100000，默认 2048；0 表示空场景。
# 增加数量会提高模拟及绘制负载；修改数量会调整现有个体数组，Reset 可重新生成。
scenarios.boids.count = 2048

# 模拟计算后端。可选 gpu（GPU compute，默认）或 cpu（CPU）。
# GPU 初始化失败时回退 CPU；界面可随时切换，保留当前模拟状态。
# 光标吸引/排斥仅在 CPU 后端生效；自动回退不会永久改写已保存的 GPU 偏好。
scenarios.boids.backend = gpu

# 是否暂停 Boids 模拟。on/off，默认 off；on 时停止自动推进模拟时间。
# 暂停时仍可操作相机、修改参数，也可用面板 Step 按钮前进一步（1/120 模拟秒）。
scenarios.boids.paused = off

# ── Boids 场景：邻居规则 ────────────────────────────────────────────
# 三条规则分别计算转向贡献，乘以权重后叠加，再受 max_acceleration 限制。
# 权重越大，该规则的相对影响越强；三条规则之间共同决定最终轨迹。
# 每条规则独立使用自己的感知半径，半径越大通常需要处理更多邻居。

# 对齐规则权重。范围 0..5，默认 0.45；0 关闭此规则。
# 使自身速度趋向附近个体的平均速度，帮助群体形成一致的运动方向和速度。
scenarios.boids.alignment_weight = 0.45

# 对齐规则的邻居感知半径，单位为世界单位。范围 0..15，默认 5。
# 仅该距离以内的个体参与平均速度计算；0 时不采纳任何邻居。
scenarios.boids.alignment_radius = 5

# 聚合规则权重。范围 0..5，默认 0.11；0 关闭此规则。
# 使个体趋向附近邻居的中心，增强聚群倾向；过强时可能形成更密集的团块。
scenarios.boids.cohesion_weight = 0.11

# 聚合规则的邻居感知半径，单位为世界单位。范围 0..15，默认 6。
# 该半径决定计算邻居中心时考虑多大范围；0 时不产生聚合贡献。
scenarios.boids.cohesion_radius = 6

# 分离规则权重。范围 0..5，默认 2；0 关闭此规则。
# 推开附近邻居，距离越近通常排斥越强，帮助减少拥挤；不保证个体绝不重叠。
scenarios.boids.separation_weight = 2

# 分离规则的邻居感知半径，单位为世界单位。范围 0..15，默认 2。
# 该距离内的邻居参与排斥计算；它是行为作用范围，并非绘制尺寸或硬碰撞半径。
# 0 时不产生分离贡献。
scenarios.boids.separation_radius = 2

# ── Boids 场景：速度与世界边界 ──────────────────────────────────────

# 个体速度下限，单位为世界单位/模拟秒。范围 0..30，默认 1；本示例为 8。
# 每步会将低于下限的速度提升到下限；0 允许停止运动，不会主动使群体停止。
# 必须满足 min_speed <= max_speed；两个值在全部配置行读完后联合校验。
scenarios.boids.min_speed = 8

# 个体速度上限，单位为世界单位/模拟秒。范围 0.1..30，默认 8；本示例为 14。
# 超过上限的速度会被限制；必须不小于 min_speed。启动/Reset 的初始速率取两者平均值。
# view.color=speed 时也用此上限作为颜色归一化的参考值。
scenarios.boids.max_speed = 14

# 三条 Boids 规则合成加速度的大小上限，单位为世界单位/模拟秒²。
# 范围 0..60，默认 20；越小通常转向和调速越缓，0 禁止规则产生加速度。
# 该项不限制光标干预的速度增量；干预后的最终速度仍受 min_speed/max_speed 限制。
scenarios.boids.max_acceleration = 20

# 世界边界模式。可选 wrap（默认）或 bounce，适用于三轴 [-40, 40] 的边界。
# wrap：从一侧越界后回到相对侧，邻居查询和光标力也按周期世界计算最短距离。
# bounce：在边界反射运动方向。显示世界线框的开关不会改变此行为。
scenarios.boids.boundary = wrap

# ── Boids 场景：光标交互（仅 CPU 后端生效）──────────────────────────

# 是否启用光标力。on/off，默认 off；on 时悬停在有效世界投影点即可施力。
# 鼠标位于 UI、操作相机、离开窗口、窗口失焦或投影点无效时暂停施力。
# GPU 模式保留这些设置，切回 CPU 后可继续使用；无需按住鼠标按钮。
scenarios.boids.cursor.enabled = off

# 光标力方向。repel（默认）使个体远离光标投影点，attract 使其靠近投影点。
# 需同时启用 cursor.enabled，并使用 CPU 后端。
scenarios.boids.cursor.mode = repel

# 以光标投影点为中心的球形作用半径，单位为世界单位。范围 0..20，默认 8。
# 屏幕中的圆环标示该球形范围；球外无效，0 关闭实际施力。
scenarios.boids.cursor.radius = 8

# 光标力强度，表示中心附近每模拟秒施加的速度变化量。
# 范围 0..100，默认 30；从中心到作用半径边缘平滑衰减为 0。
# 0 不改变速度；增大此值会增强吸引/排斥，但最终速率仍受速度上下限约束。
scenarios.boids.cursor.strength = 30

# 鼠标射线与水平 XZ 交互平面相交时采用的 Y 坐标，单位为世界单位。
# 范围 -39..39，默认 0（世界中间高度）；决定光标力中心所在的高度。
# 力仍作用于中心周围的三维球形区域，不仅作用于这个平面上的个体。
scenarios.boids.cursor.plane_height = 0

# ── 蚁群场景：世界与运行状态 ────────────────────────────────────────
# 蚁群在水平 XZ 平面上觅食，将食物搬回巢穴，并避开游荡的敌对生物。
# 随机生成地形障碍、食物与敌对生物；信息素从零开始，由蚂蚁活动逐步留下、扩散和挥发。
# 世界覆盖 [-80, 80]²（160×160），信息素使用 256×256 网格；模拟使用 CPU。

# 蚂蚁数量。整数范围 0..20000，默认 1500；0 仍保留巢穴、障碍、食物和敌对生物。
scenarios.ants.count = 1500

# 随机石块障碍数量。整数范围 0..48，默认 24；0 为无障碍地形。
# 障碍避开蚁巢和食物，不相互重叠；蚂蚁和敌对生物绕行，信息素不能穿过障碍。
# 修改数量会按当前种子重建整个世界，保留其他参数和暂停状态。
scenarios.ants.obstacle_count = 24

# 世界随机种子。整数范围 0..2147483647，默认 12345。
# 相同种子与参数可复现初始布局；重新生成世界会清除已有轨迹与信息素。
# 保存种子和参数，不保存已搬运食物、当前个体位置或敌对生物位置。
scenarios.ants.seed = 12345

# 是否暂停蚁群模拟。on/off，默认 off；独立于 Boids 和预览的暂停状态。
scenarios.ants.paused = off

# 自动补充食物的间隔，单位为模拟秒。范围 1..120，默认 10。
# 初始生成 6 片食物；每个间隔随机补充 2 片，先复用耗尽食物的位置槽，最多同时保留 24 片。
# 达到上限时跳过超出的生成，不移除仍有余量的食物；暂停或切换到其他场景时停止计时。
# 修改间隔或重置世界后重新计时；相同种子与参数可复现后续补充的食物。
scenarios.ants.food_spawn_interval = 10

# ── 蚁群场景：移动与信息素 ──────────────────────────────────────────

# 移动速度，单位为世界单位/模拟秒。范围 0.1..20，默认 6。
scenarios.ants.speed = 6

# 信息素采样距离，单位为世界单位。范围 0.1..10，默认 3。
# 蚂蚁比较前方和左右两侧的采样值，用于寻找食物或返回巢穴。
scenarios.ants.sensor_distance = 3

# 左右采样方向相对前进方向的夹角，单位为弧度。范围 0.05..1.5，默认 0.65。
scenarios.ants.sensor_angle = 0.65

# 转向速率，单位为弧度/模拟秒。范围 0.1..12，默认 4。
scenarios.ants.turn_speed = 4

# 自发探索的随机转向强度。范围 0..8，默认 1.2；0 关闭这项随机扰动。
# 此随机性只影响个体探索，不会随机初始化信息素。
scenarios.ants.wander = 1.2

# 信息素沉积速率。范围 0..20，默认 4；0 停止产生新的信息素。
# 出巢探索留下归巢信息素，携带食物返回时留下食物信息素。
scenarios.ants.deposit_rate = 4

# 信息素挥发速率。范围 0..3，默认 0.18；越大消退越快，0 禁止挥发。
scenarios.ants.evaporation = 0.18

# 信息素扩散强度。范围 0..8，默认 1.5；越大越快向相邻网格扩散，0 禁止扩散。
scenarios.ants.diffusion = 1.5

# ── 蚁群场景：显示 ──────────────────────────────────────────────────
# 下列开关仅控制显示，隐藏信息素后蚂蚁仍会感知并留下轨迹。

# 是否显示归巢信息素。on/off，默认 on。
scenarios.ants.show_home_pheromone = on

# 是否显示食物信息素。on/off，默认 on。
scenarios.ants.show_food_pheromone = on

# 蚂蚁的显示尺寸缩放系数。范围 0.1..1.5，默认 0.5；不改变感知和移动行为。
scenarios.ants.agent_size = 0.5

# ── Particle Life 场景：种类与运行状态 ──────────────────────────────
# 粒子在水平 XZ 平面上活动，X、Z 范围均为 [-50, 50)，按有向种类规则形成团簇与运动结构。
# 使用周期边界，越过世界一侧的粒子从相对侧返回，边缘邻居按最短周期距离相互作用。
# 参数、种子和规则矩阵会保存；每次启动重新生成粒子的位置与速度。

# 粒子数量。整数范围 0..10000，默认 2000；0 表示空场景。
scenarios.particle_life.count = 2000

# 模拟计算后端。可选 gpu（GPU compute，默认）或 cpu（CPU）。
# GPU 初始化失败时回退 CPU；自动回退保留 GPU 偏好，供下次启动重试。
# 面板切换成功后会保存所选后端；切换保留粒子状态、规则矩阵和模拟时间。
scenarios.particle_life.backend = gpu

# 粒子种子。整数范围 0..2147483647，默认 12345；用于复现初始粒子布局。
# 默认规则固定；面板的 Rule seed 独立生成规则，保存的是完整矩阵。
scenarios.particle_life.seed = 12345

# 粒子种类数。整数范围 1..8，默认 6；各类使用独立颜色。
# 矩阵固定保存 8×8 项，当前仅使用前 species_count 行与列。
scenarios.particle_life.species_count = 6

# 是否暂停粒子生命模拟。on/off，默认 off；与其他场景的暂停状态独立。
scenarios.particle_life.paused = off

# ── Particle Life 场景：作用力与显示 ────────────────────────────────

# 相互作用半径，单位为世界单位。范围 1..30，默认 12；范围外的粒子不产生作用力。
scenarios.particle_life.interaction_radius = 12

# 作用力整体强度。范围 0..100，默认 30；0 关闭粒子间的作用力。
scenarios.particle_life.force = 30

# 速度衰减系数。范围 0..20，默认 4；越大阻尼越强，0 不衰减速度。
scenarios.particle_life.friction = 4

# 核心区域的排斥强度。范围 0..5，默认 2；防止粒子因吸引而无限聚集。
scenarios.particle_life.repulsion = 2

# 核心区域半径相对 interaction_radius 的比例。范围 0.05..0.8，默认 0.3。
# 核心内各类粒子统一排斥，核心外至作用半径之间采用下方规则矩阵。
scenarios.particle_life.core_ratio = 0.3

# 速度上限，单位为世界单位/模拟秒。范围 1..100，默认 20。
scenarios.particle_life.max_speed = 20

# 粒子的显示尺寸缩放系数。范围 0.1..1.5，默认 0.6；只改变外观，不改变作用力。
scenarios.particle_life.agent_size = 0.6

# ── Particle Life 场景：有向规则矩阵 ────────────────────────────────
# off（默认）使用场景生成的初始规则；on 使用本文件中的 matrix 行列值。
# 程序保存当前规则时会设为 on，以便下次启动恢复面板中调整过的矩阵。
# 手工修改 matrix 时请同时设为 on；设回 off 可在下次启动重新生成默认规则。
scenarios.particle_life.custom_matrix = off

# 键名 matrix.行.列：行是受力粒子的种类，列是施力邻居的种类，编号均为 0..7。
# 每项范围 -1..1：正值吸引、负值排斥、0 无矩阵作用力；近距离核心排斥仍然生效。
# matrix.0.1 控制种类 0 对种类 1 的反应，与 matrix.1.0 无需相等。
# 缺失项默认 0；下列零矩阵在 custom_matrix=off 时不生效。
scenarios.particle_life.matrix.0.0 = 0
scenarios.particle_life.matrix.0.1 = 0
scenarios.particle_life.matrix.0.2 = 0
scenarios.particle_life.matrix.0.3 = 0
scenarios.particle_life.matrix.0.4 = 0
scenarios.particle_life.matrix.0.5 = 0
scenarios.particle_life.matrix.0.6 = 0
scenarios.particle_life.matrix.0.7 = 0
scenarios.particle_life.matrix.1.0 = 0
scenarios.particle_life.matrix.1.1 = 0
scenarios.particle_life.matrix.1.2 = 0
scenarios.particle_life.matrix.1.3 = 0
scenarios.particle_life.matrix.1.4 = 0
scenarios.particle_life.matrix.1.5 = 0
scenarios.particle_life.matrix.1.6 = 0
scenarios.particle_life.matrix.1.7 = 0
scenarios.particle_life.matrix.2.0 = 0
scenarios.particle_life.matrix.2.1 = 0
scenarios.particle_life.matrix.2.2 = 0
scenarios.particle_life.matrix.2.3 = 0
scenarios.particle_life.matrix.2.4 = 0
scenarios.particle_life.matrix.2.5 = 0
scenarios.particle_life.matrix.2.6 = 0
scenarios.particle_life.matrix.2.7 = 0
scenarios.particle_life.matrix.3.0 = 0
scenarios.particle_life.matrix.3.1 = 0
scenarios.particle_life.matrix.3.2 = 0
scenarios.particle_life.matrix.3.3 = 0
scenarios.particle_life.matrix.3.4 = 0
scenarios.particle_life.matrix.3.5 = 0
scenarios.particle_life.matrix.3.6 = 0
scenarios.particle_life.matrix.3.7 = 0
scenarios.particle_life.matrix.4.0 = 0
scenarios.particle_life.matrix.4.1 = 0
scenarios.particle_life.matrix.4.2 = 0
scenarios.particle_life.matrix.4.3 = 0
scenarios.particle_life.matrix.4.4 = 0
scenarios.particle_life.matrix.4.5 = 0
scenarios.particle_life.matrix.4.6 = 0
scenarios.particle_life.matrix.4.7 = 0
scenarios.particle_life.matrix.5.0 = 0
scenarios.particle_life.matrix.5.1 = 0
scenarios.particle_life.matrix.5.2 = 0
scenarios.particle_life.matrix.5.3 = 0
scenarios.particle_life.matrix.5.4 = 0
scenarios.particle_life.matrix.5.5 = 0
scenarios.particle_life.matrix.5.6 = 0
scenarios.particle_life.matrix.5.7 = 0
scenarios.particle_life.matrix.6.0 = 0
scenarios.particle_life.matrix.6.1 = 0
scenarios.particle_life.matrix.6.2 = 0
scenarios.particle_life.matrix.6.3 = 0
scenarios.particle_life.matrix.6.4 = 0
scenarios.particle_life.matrix.6.5 = 0
scenarios.particle_life.matrix.6.6 = 0
scenarios.particle_life.matrix.6.7 = 0
scenarios.particle_life.matrix.7.0 = 0
scenarios.particle_life.matrix.7.1 = 0
scenarios.particle_life.matrix.7.2 = 0
scenarios.particle_life.matrix.7.3 = 0
scenarios.particle_life.matrix.7.4 = 0
scenarios.particle_life.matrix.7.5 = 0
scenarios.particle_life.matrix.7.6 = 0
scenarios.particle_life.matrix.7.7 = 0

# ── 显示选项 ────────────────────────────────────────────────────────
# 全屏、面板、抗锯齿、网格、边界及相机由 Boids、蚁群、粒子生命和程序化预览共用。
# 绘制形状由 Boids 和预览共用；蚁群始终使用按运动方向转动的蚂蚁轮廓。
# Boids 的尺寸和颜色由 view.agent_size/view.color 控制，其他场景使用独立尺寸项。
# 蚁群根据觅食、搬运等状态着色，粒子生命按种类着色，均不使用 view.color。

# 是否全屏。on/off，默认 off；本示例为 on。运行中按 F11 或用面板开关切换。
# 全屏使用窗口所在的显示器；同一次运行中退出全屏会恢复原窗口位置和尺寸。
view.fullscreen = on

# 是否显示控制面板。on/off，默认 on；F1 可随时显示/隐藏。
# 隐藏面板后模拟和相机操作继续，适合只观察群体运动。
view.panel_visible = on

# Boids 和预览个体的绘制形状。arrow（默认）为箭头，dot 为始终朝向相机的圆点。
# 箭头按速度在屏幕平面上的投影指向；该项只影响外观，不改变运动规则。
view.agent_shape = arrow

# Boids 个体的显示尺寸缩放系数。范围 0.1..1.5，默认 0.45。
# 在世界空间缩放绘制图形，并非固定像素大小；相机拉远后屏幕上仍会变小。
# 只改变外观，不改变感知半径、速度或个体间的作用力；蚁群和预览有独立尺寸项。
view.agent_size = 0.45

# Boids 着色方式。可选 direction（默认）、speed、density、solid。
# direction：按归一化的 XYZ 速度方向映射 RGB，静止个体显示灰色。
# speed：按实际速率/max_speed 从蓝色过渡到橙红色，越快越接近橙红色。
# density：统计半径 5 内的邻居，0 个为蓝色，32 个及以上为橙红色，包含周期边界邻居。
# solid：统一青蓝色。颜色只影响显示；density 还需额外计算邻居数量。
view.color = direction

# 是否启用多重采样抗锯齿（MSAA）。on/off，默认 on，用于平滑箭头和圆点边缘。
# 开启后优先使用 4x，硬件不支持时尝试 2x，均不支持则退回单采样。
# 可能增加显存和渲染开销；切换时重建相关渲染资源，模拟与相机状态保留。
view.antialiasing = on

# 是否显示地面参考网格。on/off，默认 on；Boids 和预览网格位于 y=-40 的 XZ 平面。
# 蚁群网格位于 y=0，与蚂蚁和食物所在平面一致。
# 用于判断空间位置和尺度；该网格没有碰撞或施力效果。
view.grid = on

# 是否显示世界边界线框。on/off，默认 on；Boids 和预览为 [-40, 40]³ 的立方体。
# 蚁群为 y=0 平面上 [-80, 80]² 的正方形边框。
# 只控制线框可见性；隐藏后 Boids 的 wrap/bounce 和蚁群的反弹边界仍正常生效。
view.bounds = on

# ── 相机：轨道旋转中心、角度与距离 ──────────────────────────────────
# target_* 是注视目标，也是左键拖动旋转的中心；相机实际位置由目标、角度、距离共同确定。
# 左键旋转、中键平移、滚轮缩放都会更新这些值；Reset camera 恢复代码默认取景。

# 注视目标的 X 坐标（世界单位）。范围 -100000..100000，默认 0。
# 修改此值使取景中心沿 X 轴平移，可用于观察沿 X 轴分布的不同区域。
view.camera.target_x = 0

# 注视目标的 Y 坐标（世界单位）。范围 -100000..100000，默认 0。
# Y 为竖直方向；增大此值将取景中心移高，减小则移低。
view.camera.target_y = 0

# 注视目标的 Z 坐标（世界单位）。范围 -100000..100000，默认 0。
# 修改此值使取景中心沿水平 Z 轴平移；三个目标坐标都可以位于世界边界之外。
view.camera.target_z = 0

# 相机绕竖直 Y 轴的方位角，单位为弧度。范围 [-pi, pi]，默认 pi/4（45°）。
# 0 表示相机在目标的 +Z 一侧；pi/2 表示在 +X 一侧，决定从哪个水平方向观察。
view.camera.yaw = 0.7853982

# 相机的俯仰角，单位为弧度。范围 [-(pi/2-0.01), pi/2-0.01]，约 ±1.5607963。
# 默认 pi/6（30°）；正值从上方俯视，0 为水平观察，负值从下方仰视。
# 范围略小于 ±90°，避免相机恰好竖直时的取景退化。
view.camera.pitch = 0.5235988

# 相机到注视目标的距离，单位为世界单位。范围 3..2000，默认 220。
# 增大拉远、缩小画面中的个体；减小拉近。滚轮缩放直接调整这个距离。
view.camera.distance = 220

# ── 程序化渲染预览（仅 --render-preview 模式使用）────────────────────
# 预览按预设轨迹生成粒子，用于检查显示效果，不使用 Boids 的邻居规则和速度限制。
# 以下四项独立记忆，避免预览操作改动正式 Boids 场景的数量、暂停、颜色和尺寸。

# 预览粒子数量。整数范围 0..20000，默认 2048；0 显示空预览。
# 增加数量可观察绘制密度和渲染负载，不会修改 scenarios.boids.count。
scenarios.preview.count = 2048

# 是否推进预览动画时间。on/off，默认 on；off 冻结预设轨迹动画。
# 冻结时仍可操作相机和显示选项；该开关与 Boids 的 paused 相互独立。
scenarios.preview.animate = on

# 预览着色方式。可选 direction（默认）、speed、solid；预览不提供 density。
# direction：按预设轨道的角度变化色相；speed：按生成的轨道角速度参数着色。
# solid：统一青蓝色。预览的 direction/speed 不是 Boids 的 XYZ 方向/线速度映射。
scenarios.preview.color = direction

# 预览粒子的显示尺寸缩放系数。范围 0.15..1.8，默认 0.65。
# 与 view.agent_size 一样按世界空间缩放图形，仅作用于预览，不修改 Boids 显示尺寸。
scenarios.preview.agent_size = 0.65
