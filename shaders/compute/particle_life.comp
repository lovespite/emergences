#version 450

// Matches sim::Agent exactly (std430, 48 bytes). Species are separate metadata;
// IDs, colors, sizes and reserved fields survive every update unchanged.
struct Agent {
    vec3 position; float size;
    vec3 velocity; float reserved;
    vec3 color; uint id;
};
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Previous { Agent previous[]; };
layout(std430, binding = 1) writeonly buffer Next { Agent next[]; };
layout(std430, binding = 2) readonly buffer Species { uint species[]; };
layout(std430, binding = 3) readonly buffer Matrix { float interactions[]; };
layout(push_constant) uniform Push {
    uvec4 counts; // particles, stage (0 evolve, 1 clamp)
    vec4 dynamics; // dt, damping, maximum speed, unused
    vec4 interaction; // radius, force, repulsion, core ratio
} pc;

shared vec2 tilePositions[128];
shared uint tileIds[128];
shared uint tileSpecies[128];
shared float matrix[64];

vec2 displacement(vec2 from, vec2 to) {
    vec2 delta = to - from;
    // Keep the CPU's signed half-period ties at exactly +50 / -50.
    for (int axis = 0; axis < 2; ++axis) {
        if (delta[axis] > 50.0) delta[axis] -= 100.0;
        else if (delta[axis] < -50.0) delta[axis] += 100.0;
    }
    return delta;
}

vec2 overlapDirection(uint receiver, uint source) {
    uint low = min(receiver, source), high = max(receiver, source);
    uint hash = low * 0x9E3779B9u ^ high * 0x85EBCA6Bu;
    hash ^= hash >> 16u;
    hash *= 0x7FEB352Du;
    hash ^= hash >> 15u;
    const float diagonal = 0.7071067811865475;
    const vec2 directions[8] = vec2[8](
        vec2(1, 0), vec2(diagonal, diagonal), vec2(0, 1), vec2(-diagonal, diagonal),
        vec2(-1, 0), vec2(-diagonal, -diagonal), vec2(0, -1), vec2(diagonal, -diagonal));
    return directions[hash % 8u] * (receiver < source ? 1.0 : -1.0);
}

float radialForce(float distance, float attraction) {
    if (distance >= 1.0) return 0.0;
    float coreRatio = pc.interaction.w;
    if (distance < coreRatio) return pc.interaction.z * (distance / coreRatio - 1.0);
    return attraction * max(0.0, 1.0 - abs(2.0 * distance - 1.0 - coreRatio) / (1.0 - coreRatio));
}

vec2 limitSpeed(vec2 velocity) {
    float scale = max(abs(velocity.x), abs(velocity.y));
    if (scale == 0.0) return velocity;
    vec2 scaled = velocity / scale;
    float scaledLength = length(scaled);
    float maximum = pc.dynamics.z;
    // The CPU validates snapshots with a double-precision length. A small
    // inward rounding margin keeps GPU-produced values within that strict cap.
    float safeMaximum = maximum * (1.0 - 2.0 * 1.1920928955078125e-7);
    if (scale * scaledLength > safeMaximum) return (scaled / scaledLength) * safeMaximum;
    return velocity;
}

float wrapPosition(float value) {
    if (value >= -50.0 && value < 50.0) return value;
    // Fast single-period folding also avoids cancellation around the lower
    // boundary for normal fixed steps. The fallback supports larger dt values.
    if (value >= 50.0 && value < 150.0) return value - 100.0;
    if (value < -50.0 && value >= -150.0) {
        return min(value + 100.0, uintBitsToFloat(floatBitsToUint(50.0) - 1u));
    }
    return clamp(-50.0 + mod(value + 50.0, 100.0), -50.0,
                 uintBitsToFloat(floatBitsToUint(50.0) - 1u));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    bool inRange = index < pc.counts.x;
    if (pc.counts.y == 1u) {
        if (inRange) {
            Agent self = previous[index];
            self.velocity.xz = limitSpeed(self.velocity.xz);
            next[index] = self;
        }
        return;
    }

    // Padded lanes still participate in every shared-memory barrier.
    Agent self = previous[min(index, pc.counts.x - 1u)];
    uint row = species[min(index, pc.counts.x - 1u)] * 8u;
    if (lane < 64u) matrix[lane] = interactions[lane];
    precise vec2 acceleration = vec2(0.0);
    precise vec2 correction = vec2(0.0);
    float radiusSquared = pc.interaction.x * pc.interaction.x;

    // Tiled all-pairs evaluation has no occupancy limits or neighbor cutoff.
    // In dense late-stage clusters, each position is loaded from global memory
    // once per workgroup and reused by all 128 receiving particles.
    for (uint tile = 0u; tile < pc.counts.x; tile += 128u) {
        uint source = tile + lane;
        if (source < pc.counts.x) {
            tilePositions[lane] = previous[source].position.xz;
            tileIds[lane] = previous[source].id;
            tileSpecies[lane] = species[source];
        }
        barrier();
        if (inRange && pc.interaction.y > 0.0) {
            uint tileCount = min(128u, pc.counts.x - tile);
            for (uint other = 0u; other < tileCount; ++other) {
                if (tile + other == index) continue;
                vec2 delta = displacement(self.position.xz, tilePositions[other]);
                float distanceSquared = dot(delta, delta);
                if (distanceSquared > radiusSquared) continue;
                float distance = sqrt(distanceSquared);
                vec2 direction = distance > 0.0 ? delta / distance
                    : overlapDirection(self.id, tileIds[other]);
                float force = radialForce(distance / pc.interaction.x, matrix[row + tileSpecies[other]]);
                // Compensated float summation remains portable to GPUs without
                // float64 while reducing error relative to CPU double sums.
                precise vec2 contribution = direction * (force * pc.interaction.y);
                precise vec2 adjusted = contribution - correction;
                precise vec2 updated = acceleration + adjusted;
                correction = (updated - acceleration) - adjusted;
                acceleration = updated;
            }
        }
        barrier();
    }
    if (inRange) {
        precise vec2 velocity = (self.velocity.xz + acceleration * pc.dynamics.x) * pc.dynamics.y;
        self.velocity.xz = limitSpeed(velocity);
        precise vec2 position = self.position.xz + self.velocity.xz * pc.dynamics.x;
        self.position.x = wrapPosition(position.x);
        self.position.z = wrapPosition(position.y);
        next[index] = self;
    }
}
